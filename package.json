{
  "name": "@taybart/corvid",
  "version": "0.2.6",
  "type": "module",
  "sideEffects": false,
  "license": "BSD-3-Clause",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./ls": {
      "types": "./dist/local_storage.d.ts",
      "import": "./dist/ls.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "import": "./dist/qr.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./strings": {
      "types": "./dist/strings.d.ts",
      "import": "./dist/strings.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle/corvid.bundle.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@rslib/core": "^1.0.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
